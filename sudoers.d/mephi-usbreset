# Разрешить пользователю pi выполнять usbreset без пароля.
#
# Нужно ТОЛЬКО для mephi_hw_tests/lidar_watchdog.sh: скрипт работает от pi
# (не root — иначе Fast-DDS shared-memory транспорт ломается между
# root-процессом лидара и pi-процессами остального стека, см. коммит),
# и для программного "передёргивания" USB-порта лидара нужен root just for
# этой одной команды. Больше ничего этим правилом не разрешено.
pi ALL=(root) NOPASSWD: /usr/bin/usbreset
